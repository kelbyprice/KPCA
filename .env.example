# Copy to .env and fill in real values. Never commit .env.

# ---- Payload ----
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# ---- Database (Supabase Postgres) ----
# Supabase: Project → Settings → Database → Connection string (URI)
# For Vercel deployments, use the pooled (port 6543) connection.
DATABASE_URI=

# ---- Clerk ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Where Clerk sends users for auth flows. Defaults are fine for our routes.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ---- Stripe (via Clerk Billing) ----
# Configured inside Clerk Billing dashboard, not here.
